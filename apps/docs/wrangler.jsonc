{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runta-next-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".vitepress/dist",
    "binding": "ASSETS",
    // The site is fully static, so a miss is a genuine 404 rather than a route to hand back index.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "runta-cli.haxzie.com", "custom_domain": true }]
}
