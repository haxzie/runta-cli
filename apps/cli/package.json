{
  "name": "@haxzie/runta-next",
  "version": "0.7.0",
  "description": "An experimental command line interface for Runta",
  "type": "module",
  "license": "MIT",
  "homepage": "https://runta.haxzie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haxzie/runta-cli.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/haxzie/runta-cli/issues"
  },
  "keywords": [
    "runta",
    "cli",
    "sandbox",
    "runtime"
  ],
  "bin": {
    "runta-next": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "predev": "pnpm --filter @runta/api run generate",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=node --define RUNTA_VERSION=\"\\\"$npm_package_version\\\"\" --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@runta/api": "workspace:*",
    "@runta/core": "workspace:*",
    "@runta/tsconfig": "workspace:*",
    "@runta/utils": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "commander": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
