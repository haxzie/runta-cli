{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["CI"],
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**", "openapi.json"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      // `generate` as well as upstream builds: @runta/api's tests import src/generated, which
      // does not exist in a fresh clone. Without this, `pnpm test` before `pnpm build` fails with
      // "Cannot find module './client.gen'" — which looks like flakiness and is not.
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "package.json"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
