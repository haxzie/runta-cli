{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@runta/tsconfig/library",
  "extends": "./base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "types": ["node"]
  },
  "include": ["${configDir}/src/**/*.ts"]
}
