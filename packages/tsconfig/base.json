{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@runta/tsconfig/base",
  "compilerOptions": {
    "target": "ES2023",
    // DOM is here for the Web API types (fetch/Request/Response/BodyInit) that the
    // generated API client references. Neither @types/node nor @types/bun declares
    // `BodyInit` globally. Nothing in this repo runs in a browser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
