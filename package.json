{
  "name": "runta-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "pnpm api:generate",
    "dev": "bun run --watch apps/cli/src/index.ts",
    "dev:once": "bun run apps/cli/src/index.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "api:generate": "pnpm --filter @runta/api run generate",
    "api:sync": "pnpm --filter @runta/api run sync",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "clean": "turbo run clean && rm -rf node_modules dist .turbo",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm build:binaries"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
