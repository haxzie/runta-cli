{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runta-install",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_REPO": "haxzie/runta-cli",
    "DEFAULT_REF": "main",
    "SCRIPT_PATH": "scripts/install.sh"
  },
  // A custom domain rather than a route pattern: this Worker owns the hostname outright, and
  // Cloudflare manages the DNS record and certificate for it. That ownership is why the docs are
  // reached by service binding below rather than by routing a second Worker at the same host.
  "routes": [{ "pattern": "runta.haxzie.com", "custom_domain": true }],
  "services": [{ "binding": "DOCS", "service": "runta-next-docs" }]
}
