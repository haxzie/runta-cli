{
  "$schema": "https://unpkg.com/@changesets/config@3.1.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "haxzie/runta-cli"
    }
  ],
  "commit": false,
  "fixed": [["@runta/*", "@haxzie/runta-next"]],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": ["@runta/tsconfig", "@runta/install-worker", "@runta/docs"],
  "privatePackages": {
    "version": true,
    "tag": false
  }
}
