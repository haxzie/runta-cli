# Copy to `.env` (gitignored) and adjust. Loaded by `pnpm dev`. Every value here is
# optional — the defaults work offline.
#
# Nothing here configures codegen: `packages/api/openapi.json` is a hand-maintained
# file in the repo and `pnpm api:generate` reads it directly, with no network access.
# See packages/api/NOTES.md for why.

# API the CLI talks to at runtime. Overrides `apiUrl` in ~/.runta/config.json.
# RUNTA_API_URL=http://localhost:8080

# Bearer token for local development, so `runta whoami` works without logging in.
# RUNTA_TOKEN=

# silent | error | warn | info | debug  (--verbose and --quiet override this)
# RUNTA_LOG_LEVEL=debug
