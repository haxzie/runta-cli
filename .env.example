# Copy to `.env` (gitignored) and adjust. Loaded by `pnpm dev` and by the SDK
# codegen scripts. Every value here is optional — the defaults work offline.

# OpenAPI spec to generate the SDK from. Fetched into the committed snapshot at
# packages/api/openapi.json by `pnpm api:sync`; a failed fetch falls back to it.
#
# Runta does not currently publish an openapi.json (every candidate URL 404s), so
# packages/api/openapi.json is maintained by hand and api:sync always falls back.
# Leave this unset, or set RUNTA_SKIP_API_SYNC=1 to skip the doomed fetch entirely.
# See packages/api/NOTES.md.
# RUNTA_OPENAPI_URL=https://api.runta.com/openapi.json

# API the CLI talks to at runtime. Overrides `apiUrl` in ~/.runta/config.json.
# RUNTA_API_URL=http://localhost:8080

# Bearer token for local development, so `runta whoami` works without logging in.
# RUNTA_TOKEN=

# silent | error | warn | info | debug  (--verbose and --quiet override this)
# RUNTA_LOG_LEVEL=debug

# Never fetch the spec; always use the committed snapshot. What CI sets.
# RUNTA_SKIP_API_SYNC=1

# How stale the snapshot may be before `pnpm api:generate` refetches. Default 1h.
# RUNTA_SPEC_TTL_MS=3600000
